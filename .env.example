# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Database — leave empty to use SQLite (backend/db.sqlite3).
# Production (Vercel): Neon/Vercel Postgres URL
DATABASE_URL=

# CORS / frontend origin
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# App
DEFAULT_CURRENCY=PKR
DEFAULT_CURRENCY_SYMBOL=Rs.
TIME_ZONE=Asia/Karachi

# Owner workspace (used by python manage.py seed_demo)
OWNER_USERNAME=ahsan
OWNER_PASSWORD=
OWNER_DISPLAY_NAME=Ahsan Nadeem

# Groq assistant (OpenAI-compatible)
AI_API_KEY=
AI_API_BASE=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b

# Optional receipt OCR provider: none | tesseract
OCR_PROVIDER=none

# Frontend production API origin. Leave empty when UI and API share one Vercel domain.
VITE_API_URL=
